{
  "name": "illustration-constructor",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Векторный конструктор иллюстраций",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "library:build": "node scripts/build-library.mjs",
    "library:check": "node scripts/build-library.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build:core": "npm run library:build && tsc",
    "build": "npm run build:core && vite build",
    "examples:build": "npm run build:core && node scripts/generate-examples.mjs",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "check": "npm run library:check && tsc --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "lucide-react": "^1.66.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
